# bash completion for vlock(1)                           -*- shell-script -*-

_vlock_module()
{
	local cur prev opts
	COMPREPLY=()
	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD-1]}"

	case $prev in
		'-h'|'--help'|'-v'|'--version')
			return 0
			;;
	esac

	opts="
		-a --all
		-c --current
		-v --version
		-h --help
	"
	COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
	return 0
}
complete -F _vlock_module vlock
