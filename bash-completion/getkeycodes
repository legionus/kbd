# bash completion for getkeycodes(8)                     -*- shell-script -*-

_getkeycodes_module()
{
	local cur prev
	COMPREPLY=()
	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD-1]}"

	case $prev in
		'-h'|'--help'|'-V'|'--version')
			return 0
			;;
	esac

	COMPREPLY=( $(compgen -W "-V --version -h --help" -- "$cur") )
	return 0
}
complete -F _getkeycodes_module getkeycodes
