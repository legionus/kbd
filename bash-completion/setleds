# bash completion for setleds(1)                         -*- shell-script -*-

_setleds_module()
{
	local cur prev opts
	COMPREPLY=()
	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD-1]}"

	case $prev in
		'-h'|'--help'|'-V'|'--version')
			return 0
			;;
	esac

	case $cur in
		--*)
			opts="--default --flags --leds --verbose --version --help"
			COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
			return 0
			;;
		-*)
			opts="-D -F -L -v -V -h -num -caps -scroll --default --flags --leds --verbose --version --help"
			COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
			return 0
			;;
		+*)
			COMPREPLY=( $(compgen -W "+num +caps +scroll" -- "$cur") )
			return 0
			;;
	esac

	COMPREPLY=( $(compgen -W "num caps scroll +num +caps +scroll -num -caps -scroll" -- "$cur") )
	return 0
}
complete -F _setleds_module setleds
