# bash completion for setmetamode(1)                     -*- shell-script -*-

_setmetamode_module()
{
	local cur prev opts
	COMPREPLY=()
	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD-1]}"

	if [[ $prev == '=' && $COMP_CWORD -ge 2 ]]; then
		prev="${COMP_WORDS[COMP_CWORD-2]}"
	fi

	case $prev in
		'-C'|'--console')
			if [[ -z $cur || $cur == /dev* ]]; then
				COMPREPLY=( $(compgen -W "/dev/console $(compgen -G '/dev/tty[0-9]*')" -- "$cur") )
			else
				local IFS=$'\n'
				compopt -o filenames 2>/dev/null || true
				COMPREPLY=( $(compgen -f -- "$cur") )
			fi
			return 0
			;;
		'-h'|'--help'|'-V'|'--version')
			return 0
			;;
	esac

	case $cur in
		-*)
			opts="
				-C --console
				-V --version
				-h --help
			"
			COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
			return 0
			;;
	esac

	COMPREPLY=( $(compgen -W "metabit meta bit escprefix esc prefix" -- "$cur") )
	return 0
}
complete -F _setmetamode_module setmetamode
