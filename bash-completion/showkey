# bash completion for showkey(1)                         -*- shell-script -*-

_showkey_module()
{
	local cur prev opts
	COMPREPLY=()
	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD-1]}"

	if [[ $prev == '=' && $COMP_CWORD -ge 2 ]]; then
		prev="${COMP_WORDS[COMP_CWORD-2]}"
	fi

	case $prev in
		'-t'|'--timeout')
			return 0
			;;
		'-h'|'--help'|'-V'|'--version')
			return 0
			;;
	esac

	opts="
		-a --ascii
		-s --scancodes
		-k --keycodes
		-t --timeout
		-h --help
		-V --version
	"
	COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
	return 0
}
complete -F _showkey_module showkey
